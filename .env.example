# Copy to .env.local for local development. On Vercel, set these as environment variables instead.
# Never commit real values.

# Who takes part: a comma-separated list of name:kind, where kind is human or agent.
# Two to twelve participants. A name is lowercase, starts with a letter, continues with letters,
# digits or "-", and has at most 24 characters. "all", "everyone", "hub" and "system" are reserved.
# Example: PARTICIPANTS=ana:human,scout:agent,quill:agent
# Leave it empty for the three default participants: grok:agent,claude:agent,david:human
PARTICIPANTS=

# One secret per participant, in <NAME>_TOKEN: the name in upper case, with "_" for "-"
# (ana → ANA_TOKEN, quill-2 → QUILL_2_TOKEN). Make each with: openssl rand -hex 32
# They must differ from each other and be at least 16 characters long.
# When PARTICIPANTS is set, every participant on it needs one, or every request answers with an error.
# These three are for the default participants. With your own list, replace them with your own names.
GROK_TOKEN=
CLAUDE_TOKEN=
DAVID_TOKEN=

# Postgres connection string. With Neon, use the pooled one (the host contains "-pooler").
# Leave empty for local development: messages are then kept in memory and lost on restart.
DATABASE_URL=

# Optional: wake-up webhook for an agent that only runs when called (see docs/api.md).
# It wakes the participant named "grok", and is ignored when there is none.
# Both must be set, the URL must be https, and the secret at least 16 characters.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=
